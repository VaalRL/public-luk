# Database
DATABASE_URL="file:./dev.db"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Optional: Production database
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Optional: Monitoring and logging
# LOG_LEVEL="info"

# Optional: Security
# CSRF_SECRET="your-csrf-secret-here"

# Optional: Email notifications (if implemented)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-password"

# Optional: File upload limits
# MAX_FILE_SIZE="10485760" # 10MB in bytes

# 預設開立公司（乙方）
# 帳單未指定 provider 時，PDF 上顯示的開立方資訊。
# 留空則 PDF 對應欄位顯示 "-"。
# 注意：NEXT_PUBLIC_ 變數會被打包進前端，請勿放機密資訊
# —— 這裡放的本來就是會印在帳單上、對客戶公開的資料。
NEXT_PUBLIC_DEFAULT_PROVIDER_NAME=""
NEXT_PUBLIC_DEFAULT_PROVIDER_TAX_ID=""
NEXT_PUBLIC_DEFAULT_PROVIDER_CONTACT=""
NEXT_PUBLIC_DEFAULT_PROVIDER_EMAIL=""
NEXT_PUBLIC_DEFAULT_PROVIDER_PHONE=""
NEXT_PUBLIC_DEFAULT_PROVIDER_ADDRESS=""
