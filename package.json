{
  "name": "spreadsheet-comparator",
  "version": "0.1.0",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint src",
    "test": "vitest",
    "bench": "vitest bench",
    "format": "prettier --write .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3001 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:dir": "npm run build && node prepare-electron.js && electron-builder --dir",
    "electron:package": "npm run build && node prepare-electron.js && powershell -ExecutionPolicy Bypass -File ./build-electron.ps1",
    "clean": "rimraf .next dist-electron"
  },
  "build": {
    "appId": "com.spreadsheet.comparator",
    "productName": "luk",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "electron-dist-temp/server.js",
        "to": "standalone/server.js"
      },
      {
        "from": "electron-dist-temp/package.json",
        "to": "standalone/package.json"
      },
      {
        "from": "electron-dist-temp/.env",
        "to": "standalone/.env"
      },
      {
        "from": "electron-dist-temp/.next",
        "to": "standalone/.next"
      },
      {
        "from": "electron-dist-temp/public",
        "to": "standalone/public"
      },
      {
        "from": "electron-dist-temp/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": "prisma/dev.db",
        "to": "prisma/dev.db"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/**"
    ],
    "win": {
      "target": "dir",
      "icon": "public/luk-logo.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "compression": "maximum"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/noto-sans-tc": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "next": "16.0.4",
    "next-themes": "^0.4.6",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react": "19.2.0",
    "react-day-picker": "^9.11.3",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.66.1",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "ignore-loader": "^0.1.2",
    "jsdom": "^27.2.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.14",
    "wait-on": "^9.0.3"
  }
}